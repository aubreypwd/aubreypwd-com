# Symlink to this .htaccess file from the root of the WP install.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

### ─────────────────────────────
### Manual Pretty URL Rewrites
### ─────────────────────────────

# Rewrite /posts/index.html to actual static file
RewriteRule ^posts/index\.html$ /index.php?page_id=243 [L]

### ─────────────────────────────
### Old Tag Query Redirects
### ─────────────────────────────

# Only redirect from homepage with exact tag queries
RewriteCond %{QUERY_STRING} ^tag=333$
RewriteRule ^$ https://aubreypwd.com/tags/freelancing.html? [R=301,L,QSD]

RewriteCond %{QUERY_STRING} ^tag=336$
RewriteRule ^$ https://aubreypwd.com/tags/ai.html? [R=301,L,QSD]

RewriteCond %{QUERY_STRING} ^tag=334$
RewriteRule ^$ https://aubreypwd.com/tags/career-2025.html? [R=301,L,QSD]

RewriteCond %{QUERY_STRING} ^tag=335$
RewriteRule ^$ https://aubreypwd.com/tags/wp-problems.html? [R=301,L,QSD]

### ─────────────────────────────
### Standard WordPress Handling
### ─────────────────────────────

# Skip rewrite if index.php is requested directly
RewriteRule ^index\.php$ - [L]

# Route anything else to index.php if not a real file or dir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

### ─────────────────────────────
### Manual Redirects
### ─────────────────────────────

RedirectMatch 301 ^/chatbot/?$ https://chatgpt.com/g/g-68f6b866bd008191a656f81da88ed3d0-let-s-chat-about-your-project
RedirectMatch 302 ^/hire/?$ https://www.fiverr.com/aubreypwd?public_mode=true
RedirectMatch 301 ^/how-i-work/?$ /pages/how-i-work.html
RedirectMatch 301 ^/freelance/?$ /pages/freelance.html